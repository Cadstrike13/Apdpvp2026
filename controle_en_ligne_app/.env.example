# Copier en .env (jamais versionné) et renseigner les valeurs.

# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=controle.apdpvp.local
CSRF_TRUSTED_ORIGINS=http://controle.apdpvp.local
# Passer à True quand Traefik sert le service en HTTPS.
HTTPS_ACTIF=False

# Clé partagée avec auth_app pour valider les jetons JWT (identique sur tous les services).
JWT_SECRET_KEY=

LANGUAGE_CODE=fr-fr
LOG_LEVEL=INFO

# Scanners
CONTROLE_USER_AGENT=APDPVP-ControleEnLigne/1.0 (+https://apdpvp.ga ; controle en ligne)
CONTROLE_RESPECTER_ROBOTS=True
# Fenêtre Chromium visible pendant les scans (poste local / WSLg). False en conteneur.
CONTROLE_NAVIGATEUR_VISIBLE=False
# Pause entre deux actions du navigateur, en millisecondes.
CONTROLE_NAVIGATEUR_RALENTI_MS=0
CELERY_TASK_TIME_LIMIT=1800
